{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "client/assets/$1"
    },
    {
      "src": "/(hero-slides|hero-slides-mobile)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, stale-while-revalidate=604800"
      },
      "dest": "client/$1/$2"
    },
    {
      "src": "/sitemap.xml",
      "headers": {
        "Cache-Control": "public, max-age=3600, stale-while-revalidate=86400"
      },
      "dest": "client/sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "headers": {
        "Cache-Control": "public, max-age=3600, stale-while-revalidate=86400"
      },
      "dest": "client/robots.txt"
    },
    {
      "src": "/(.*\\.(webp|png|jpg|jpeg|svg|ico|woff2|woff|ttf))$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, stale-while-revalidate=604800"
      },
      "dest": "client/$1"
    },
    {
      "src": "/mentR_Logo.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000, stale-while-revalidate=604800"
      },
      "dest": "client/mentR_Logo.png"
    },
    {
      "src": "/logo.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000, stale-while-revalidate=604800"
      },
      "dest": "client/logo.png"
    },
    {
      "src": "/tab_icon.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000, stale-while-revalidate=604800"
      },
      "dest": "client/tab_icon.png"
    },
    {
      "src": "/favicon.ico",
      "headers": {
        "Cache-Control": "public, max-age=31536000, stale-while-revalidate=604800"
      },
      "dest": "client/tab_icon.png"
    },
    {
      "src": "/favicon.svg",
      "headers": {
        "Cache-Control": "public, max-age=31536000, stale-while-revalidate=604800"
      },
      "dest": "client/favicon.svg"
    },
    {
      "src": "/ChatGPT_Logo.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000, stale-while-revalidate=604800"
      },
      "dest": "client/ChatGPT_Logo.png"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "dest": "client/index.html"
    }
  ]
}
